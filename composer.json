{
    "name": "dept-of-scrapyard-robotics/wii-connector",
    "description": "Wii, NES, and SNES extension controllers over I2C for ScrapyardIO",
    "type": "library",
    "version": "0.6.0",
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/actuation": "^0.6.0",
        "fabricate/circuits": "^0.6.0",
        "fabricate/contracts": "^0.6.0",
        "fabricate/nuts-and-bolts": "^0.6.0",
        "gpio/contracts": "^0.6.0",
        "gpio/i2c": "^0.6.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "suggest": {
        "microscrap/i2c": "^0.5.0 - For direct Linux I2C",
        "microscrap/mpsse": "^0.5.0 - For I2C over an FTDI adapter"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\WiiConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\WiiConnector\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Actuators\\WiiConnector\\WiiConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
