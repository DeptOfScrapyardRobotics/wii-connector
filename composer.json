{
    "name": "dept-of-scrapyard-robotics/wii-connector",
    "description": "Read Wii extension controllers (Nunchuck, Classic Controller, NES and SNES Classic Mini) over I2C with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "wii",
        "nunchuck",
        "classic-controller",
        "snes",
        "nes",
        "gamepad",
        "i2c",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/i2c": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/io-pools": "^0.10.0"
    },
    "suggest": {
        "gpio/i2c": "^0.10.0 - I2C connections for WiiConnectorI2CTransport",
        "venusian-voyager/io-pools": "^0.10.0 - the event loop every() polls on",
        "microscrap/scrapyard-linux": "^0.10.0 - native i2c-dev driver",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE I2C over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\WiiConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\WiiConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Actuators\\WiiConnector\\Providers\\WiiConnectorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
